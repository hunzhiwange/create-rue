{
  "name": "create-rue",
  "version": "0.9.13",
  "description": "🛠️ The will to start a Vite-powered Rue project",
  "keywords": [],
  "homepage": "https://github.com/hunzhiwange/create-rue#readme",
  "bugs": {
    "url": "https://github.com/hunzhiwange/create-rue/issues"
  },
  "license": "MIT",
  "author": "XiangminLiu <xiangminliu1990@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hunzhiwange/create-rue.git"
  },
  "bin": {
    "create-rue": "bundle.js"
  },
  "files": [
    "bundle.js",
    "locales",
    "template",
    "!template/**/node_modules/.bin/*"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "scripts": {
    "prepare": "vp config",
    "format": "vp fmt . '!template/base/**'",
    "format-check": "vp fmt --check . '!template/base/**'",
    "lint": "vp lint . --fix",
    "build": "rolldown -c rolldown.config.ts",
    "test": "pnpm run build && pnpm run test:unit",
    "test:unit": "vp test",
    "preversion": "git fetch && git status -uno | grep -q 'Your branch is up to date'",
    "postversion": "zx ./scripts/postversion.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@clack/prompts": "^1.8.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^26.5.0",
    "ejs": "^6.0.1",
    "picocolors": "^1.1.1",
    "rolldown": "^1.2.7",
    "rollup-plugin-license": "^3.7.1",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "zx": "^8.8.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.3.4"
}
